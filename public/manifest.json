{
  "manifest_version": 3,
  "name": "Nymeria Browser",
  "version": "0.4.0",
  "description": "Lets the Nymeria assistant read and act in your logged-in browser, while you watch.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "debugger",
    "webNavigation",
    "webRequest"
  ],
  "optional_permissions": [],
  "host_permissions": [],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Nymeria",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
